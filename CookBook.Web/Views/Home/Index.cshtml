@{
    ViewData["Title"] = "Начало";
}

<section class="text-center py-5">
    <h1 class="display-3 fw-bold">Добре Дошли в CookBook!</h1>

    <p class="lead mt-3">
        Открийте вдъхновение за следващото си вкусно ястие!
    </p>

    <p class="text-muted">
       Събирайте, споделяйте и откривайте любими рецепти за всеки повод.
    </p>

    <a asp-controller="Home"
     asp-action="Privacy"
    class="btn btn-success btn-lg mt-3">
     Научете повече
    </a>
</section>

<hr />

<section class="container py-4">
    <h2 class="text-center mb-4">Открийте рецепти по категории</h2>

    <div class="row g-4 text-center"

    <d<div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="card-title">🥗 Салати</h3>
                    <p class="card-text">
                        Свежи и здравословни предложения.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="card-title">🍲 Супи</h3>
                    <p class="card-text">
                        Топли и вкусни супи за всеки сезон.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="card-title">🍝 Основни ястия</h3>
                    <p class="card-text">
                        Вкусни идеи за обяд и вечеря.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="card-title">🍰 Десерти</h3>
                    <p class="card-text">
                        Сладки изкушения за всеки повод.
                    </p>
                </div>
            </div>
        </div>

    </div>
</section>
